class Animal {
    String name;

    Animal(String name) {
        this.name = name;
    }

    void eat() {
        System.out.println(name + " is eating");
    }
}

class Dog extends Animal {
    Dog(String name) {
        super(name); // call parent constructor
    }

    void bark() {
        System.out.println(name + " is barking");
    }
}

class Puppy extends Dog { // multilevel inheritance
    Puppy(String name) {
        super(name);
    }

    void weep() {
        System.out.println(name + " is whining");
    }
}

public class Main {
    public static void main(String[] args) {
        Puppy p = new Puppy("Rex");
        p.eat();   // from Animal
        p.bark();  // from Dog
        p.weep();  // from Puppy
    }
}
